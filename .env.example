# Runtime / deployment
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-value
RECONNECT_GRACE_MS=30000
ACCOUNT_STORE_FILE=.data/accounts.json

# Oracle Autonomous Database (credentials are detected; install/configure the
# oracledb adapter before treating this as production persistence.)
DB_USERNAME=
DB_PASSWORD=
DB_CONNECT_STRING=

# Local art generation
LOCAL_3D_GEN_CMD=
KIMODO_CMD=kimodo_gen
KIMODO_OUTPUT_DIR=assets/generated/motion
BLENDER_BIN=blender
GLTF_TRANSFORM_CMD=gltf-transform
